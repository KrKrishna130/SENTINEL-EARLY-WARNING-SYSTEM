# Generate unique local credentials with python3 scripts/configure.py.
POSTGRES_PASSWORD=replace-with-generated-secret
JWT_SECRET=replace-with-at-least-32-random-characters
OPERATOR_PASSWORD=replace-with-generated-secret
VIEWER_PASSWORD=replace-with-generated-secret
MINIO_ACCESS_KEY=sentinel
MINIO_SECRET_KEY=replace-with-generated-secret
MINIO_BUCKET=sentinel-evidence
MINIO_SECURE=false
STORAGE_MODE=local
LOCAL_EVIDENCE_DIR=./evidence
DATABASE_URL=sqlite:///./sentinel.db
SEED_DEMO=false
# rules = deterministic demo; ollama = Qwen/Gemma locally; groq = optional external service.
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
GEMMA_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=nomic-embed-text
VECTOR_ENABLED=false
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
ALLOW_EXTERNAL_LLM=false
GROQ_API_KEY=
GROQ_MODEL=
# Default loopback only; use an SSH tunnel for a remote server.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8088

SOURCE_WEBHOOK_KEY=replace-with-generated-secret
LOGIN_WINDOW_SECONDS=300
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=host.docker.internal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sentinel_events
INGEST_URL=http://api:8000/api/live/webhook
IMAP_HOST=host.docker.internal
IMAP_PORT=1143
IMAP_FOLDER=INBOX
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=15
IMAP_CA_FILE=

MINIO_ENDPOINT=host.docker.internal:9000
AI_WARNING_REVIEW=true
TRIAGE_TIMEOUT_SECONDS=45
NETWORK_DESTINATION_LIMIT=50
NETWORK_DENIAL_LIMIT=30
WORKER_ACTIVITY_CONCURRENCY=1
