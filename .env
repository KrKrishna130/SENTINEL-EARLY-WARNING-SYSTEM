# Sentinel Live — Docker Compose on your Mac
# Save as sentinel-live/.env. Contains private credentials.
# Database and login credentials preserved from your existing Sentinel configuration.
POSTGRES_PASSWORD=eFkaGl_nSBs_MA_xdWTTwkTJ0HmgLX-swK17GD5a1pklQX8c
JWT_SECRET=FPIsQbngcnAA_UWDwWEdyFLh61fHHFhDhLaXuPcxV0RzkrW_
OPERATOR_PASSWORD=9DOMipCov_newfr3N6fAQ5mXgCeh7ArOUBLMAN3neaITqVJd
VIEWER_PASSWORD=e2CbvCwQYHoHzg8BJOVLpEsTyH0-n11AUJ3JUegS2SWGku8h

# Shared MinIO server. Credentials copied from your supplied PPT configuration.
STORAGE_MODE=minio
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=pptadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_SECURE=false
MINIO_BUCKET=sentinel-evidence
LOCAL_EVIDENCE_DIR=./evidence

# Compose overrides DATABASE_URL with its internal PostgreSQL connection.
# This value is only the fallback for running Python outside Compose.
DATABASE_URL=sqlite:///./sentinel.db
SEED_DEMO=false

# Shared Temporal server with a registered Sentinel namespace and dedicated queue.
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=host.docker.internal:7233
TEMPORAL_NAMESPACE=sentinel-live
TEMPORAL_TASK_QUEUE=sentinel_events
WORKER_ACTIVITY_CONCURRENCY=1

# Local Gemma through the existing Ollama server.
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
GEMMA_BASE_URL=http://host.docker.internal:11434/v1
AI_WARNING_REVIEW=true
TRIAGE_TIMEOUT_SECONDS=45

# Optional vectors. Enable the Compose vectors profile when enabling this flag.
VECTOR_ENABLED=true
EMBEDDING_MODEL=nomic-embed-text
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=

# Optional external assistant model.
ALLOW_EXTERNAL_LLM=false
GROQ_API_KEY=
GROQ_MODEL=

# Frontend access and authenticated ingestion.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
SOURCE_WEBHOOK_KEY=yGB272VDreefZMRVPBShu3v6INr0ygEmITFIpMVlOwSQtPIr
LOGIN_WINDOW_SECONDS=300
NETWORK_DESTINATION_LIMIT=50
NETWORK_DENIAL_LIMIT=30
INGEST_URL=http://api:8000/api/live/webhook

# Optional email connector. Configure Bridge IMAP credentials before starting mail.
IMAP_HOST=host.docker.internal
IMAP_PORT=1143
IMAP_FOLDER=INBOX
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=15
IMAP_CA_FILE=
